    let activeCategory = "semua-game";

/* RENDER PRODUK DI HALAMAN */

function renderProducts(category, searchTerm = "") {
  const categoryData = productData[category];

  if (!categoryData) return;

  activeCategory = category;
  productTitle.textContent = categoryData.title;

  const filteredProducts = categoryData.products.filter(product =>
    product.name.toLowerCase().includes(searchTerm.toLowerCase())
  );

  productGrid.innerHTML = "";

  emptyState.style.display =
    filteredProducts.length === 0 ? "block" : "none";

  filteredProducts.forEach(product => {
    const card = document.createElement("article");
    card.className = "product-card";

    const imageWrap = document.createElement("div");
    imageWrap.className = "product-image";

    const image = document.createElement("img");
    image.src = product.image;
    image.alt = product.name;
    image.loading = "lazy";

    image.onerror = function() {
      imageWrap.innerHTML =
        '<span class="product-placeholder">+</span>';
    };

    imageWrap.appendChild(image);

    const info = document.createElement("div");
    info.className = "product-info";

    const name = document.createElement("h3");
    name.textContent = product.name;

    info.appendChild(name);

    card.appendChild(imageWrap);
    card.appendChild(info);

    /* SELURUH CARD BISA DIKLIK */

    card.style.cursor = "pointer";
    card.setAttribute("role", "link");
    card.setAttribute("tabindex", "0");

    card.addEventListener("click", function() {
      if (product.link === "#") {
        alert("Link produk ini belum tersedia.");
        return;
      }

      window.location.href = product.link;
    });

    card.addEventListener("keydown", function(event) {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        card.click();
      }
    });

    productGrid.appendChild(card);
  });
}
    /* SEARCH DROPDOWN: CARI SEMUA KATEGORI */

    function closeSearchResults() {
      searchResults.classList.remove("active");
      searchResults.innerHTML = "";
      searchInput.setAttribute("aria-expanded", "false");
    }

    function showSearchResults(searchTerm) {
      const term = searchTerm.trim().toLowerCase();

      searchResults.innerHTML = "";

      // Belum menampilkan hasil jika kurang dari 3 huruf
      if (term.length < 3) {
        closeSearchResults();
        return;
      }

      const matches = [];

      // Cari produk dari seluruh kategori
      Object.entries(productData).forEach(([categoryKey, categoryData]) => {
        categoryData.products.forEach(product => {
          if (product.name.toLowerCase().includes(term)) {
            matches.push({
              ...product,
              category: categoryData.title,
              categoryKey: categoryKey
            });
          }
        });
      });

      searchResults.classList.add("active");
      searchInput.setAttribute("aria-expanded", "true");

      if (matches.length === 0) {
        const message = document.createElement("div");
        message.className = "search-result-message";
        message.textContent = "Produk tidak ditemukan.";
        searchResults.appendChild(message);
        return;
      }

      // Batasi hasil dropdown agar tidak terlalu panjang
      const limitedMatches = matches.slice(0, 8);

      limitedMatches.forEach(product => {
        const result = document.createElement("a");
        result.className = "search-result-item";
        result.href = product.link;

        const image = document.createElement("img");
        image.src = product.image;
        image.alt = product.name;
        image.loading = "lazy";

        // Fallback ikon jika gambar belum tersedia
        image.onerror = function() {
          image.style.display = "none";

          const fallback = document.createElement("div");
          fallback.className = "search-result-fallback";
          fallback.textContent = "🎮";
          fallback.setAttribute("aria-label", "Ikon produk");

          result.insertBefore(fallback, image);
        };

        const info = document.createElement("div");
        info.className = "search-result-info";

        const name = document.createElement("span");
        name.className = "search-result-name";
        name.textContent = product.name;

        const category = document.createElement("span");
        category.className = "search-result-category";
        category.textContent = product.category;

        const arrow = document.createElement("span");
        arrow.className = "search-result-arrow";
        arrow.textContent = "›";

        info.appendChild(name);
        info.appendChild(category);

        result.appendChild(image);
        result.appendChild(info);
        result.appendChild(arrow);

        // Kalau link belum tersedia, tampilkan pemberitahuan
        if (product.link === "#") {
          result.addEventListener("click", function(event) {
            event.preventDefault();
            alert("Link produk ini belum tersedia.");
          });
        }

        // Setelah hasil dipilih, tutup dropdown
        result.addEventListener("click", function() {
          closeSearchResults();
        });

        searchResults.appendChild(result);
      });
    }

    /* INPUT SEARCH */

    searchInput.addEventListener("input", function() {
      showSearchResults(searchInput.value);
    });

    // Tutup hasil pencarian jika user menekan Escape
    searchInput.addEventListener("keydown", function(event) {
      if (event.key === "Escape") {
        closeSearchResults();
        searchInput.blur();
      }
    });

    // Tutup dropdown jika user tap di luar area pencarian
    document.addEventListener("click", function(event) {
      const searchPanel = document.getElementById("searchPanel");
      const searchToggle = document.getElementById("searchToggle");

      if (
        !searchPanel.contains(event.target) &&
        !searchToggle.contains(event.target)
      ) {
        closeSearchResults();
      }
    });

    /* KLIK KATEGORI */

    categoryTabs.forEach(tab => {
      tab.addEventListener("click", function() {
        categoryTabs.forEach(item =>
          item.classList.remove("active")
        );

        tab.classList.add("active");

        searchInput.value = "";
        closeSearchResults();

        renderProducts(tab.dataset.category);

        document.getElementById("produk").scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });
    });

    /* GAME POPULER MEMILIH KATEGORI */

    document.querySelectorAll("[data-category]").forEach(item => {
      if (item.classList.contains("category-tab")) return;

      item.addEventListener("click", function() {
        const category = item.dataset.category;

        if (!category || !productData[category]) return;

        categoryTabs.forEach(tab => {
          tab.classList.toggle(
            "active",
            tab.dataset.category === category
          );
        });

        renderProducts(category);

        searchInput.value = "";
        closeSearchResults();

        document.getElementById("produk").scrollIntoView({
          behavior: "smooth",
          block: "start"
        });
      });
    });

    /* MOBILE MENU & SEARCH TOGGLE */

    const menuToggle = document.getElementById("menuToggle");
    const navLinks = document.getElementById("navLinks");
    const searchToggle = document.getElementById("searchToggle");
    const searchPanel = document.getElementById("searchPanel");

    menuToggle.addEventListener("click", () => {
      navLinks.classList.toggle("active");
    });

    navLinks.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", () => {
        navLinks.classList.remove("active");
      });
    });

    searchToggle.addEventListener("click", () => {
      searchPanel.classList.toggle("active");

      if (searchPanel.classList.contains("active")) {
        searchInput.focus();
      } else {
        searchInput.value = "";
        closeSearchResults();
      }
    });

/* PROMO CAROUSEL */

const promoWrap = document.querySelector(".promo-wrap");
const promoTrack = document.getElementById("promoTrack");
const promoSlides = document.querySelectorAll(".promo-slide");
const promoDots = document.querySelectorAll(".promo-dot");

let currentSlide = 0;
let carouselTimer;

let startX = 0;
let startY = 0;
let isPointerDown = false;
let bannerWasSwiped = false;

function showSlide(index) {
  currentSlide = index;

  promoTrack.style.transform =
    `translateX(-${index * 100}%)`;

  promoDots.forEach((dot, i) => {
    dot.classList.toggle("active", i === index);
  });
}

function startCarousel() {
  clearInterval(carouselTimer);

  if (promoSlides.length <= 1) return;

  carouselTimer = setInterval(() => {
    const next = (currentSlide + 1) % promoSlides.length;
    showSlide(next);
  }, 5000);
}

/* KLIK TITIK NAVIGASI */

promoDots.forEach((dot, index) => {
  dot.addEventListener("click", () => {
    showSlide(index);
    startCarousel();
  });
});

/* GESER MANUAL */

promoWrap.addEventListener("pointerdown", (event) => {
  if (event.target.closest(".promo-dot")) return;

  if (event.pointerType === "mouse" && event.button !== 0) return;

  startX = event.clientX;
  startY = event.clientY;
  isPointerDown = true;
});

promoWrap.addEventListener("pointerup", (event) => {
  if (!isPointerDown) return;

  isPointerDown = false;

  const distanceX = event.clientX - startX;
  const distanceY = event.clientY - startY;

  // Pastikan gerakan lebih dominan ke kiri/kanan
  if (
    Math.abs(distanceX) > 45 &&
    Math.abs(distanceX) > Math.abs(distanceY)
  ) {
    let nextSlide;

    if (distanceX < 0) {
      // Geser ke kiri: banner berikutnya
      nextSlide = (currentSlide + 1) % promoSlides.length;
    } else {
      // Geser ke kanan: banner sebelumnya
      nextSlide =
        (currentSlide - 1 + promoSlides.length) % promoSlides.length;
    }

    showSlide(nextSlide);
    startCarousel();

    bannerWasSwiped = true;

    setTimeout(() => {
      bannerWasSwiped = false;
    }, 400);
  }
});

promoWrap.addEventListener("pointercancel", () => {
  isPointerDown = false;
});

/* Cegah banner terbuka saat selesai digeser */

promoWrap.addEventListener("click", (event) => {
  if (bannerWasSwiped) {
    event.preventDefault();
    event.stopPropagation();
    bannerWasSwiped = false;
  }
}, true);

/* MULAI AUTOPLAY */

startCarousel();

